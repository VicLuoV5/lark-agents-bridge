{
  "name": "lark-agents-bridge",
  "version": "0.2.0",
  "description": "Bridge Feishu/Lark messenger with local coding agent CLIs (Codex, Claude Code, Qwen Code, Kimi Code, CodeBuddy, DeepSeek Harness)",
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "bin": {
    "lark-agents-bridge": "bin/lark-agents-bridge.mjs",
    "lark-codex-bridge": "bin/lark-codex-bridge.mjs",
    "feishu-codex-bridge": "bin/feishu-codex-bridge.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "commander": "^12.1.0",
    "https-proxy-agent": "^9.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.6"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VicLuoV5/lark-agents-bridge.git"
  },
  "homepage": "https://github.com/VicLuoV5/lark-agents-bridge#readme",
  "bugs": {
    "url": "https://github.com/VicLuoV5/lark-agents-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "feishu",
    "lark",
    "agents",
    "codex",
    "codex-cli",
    "claude-code",
    "qwen-code",
    "kimi-code",
    "codebuddy",
    "deepseek-harness",
    "feishu-bot",
    "lark-bot",
    "bridge"
  ],
  "license": "MIT"
}
